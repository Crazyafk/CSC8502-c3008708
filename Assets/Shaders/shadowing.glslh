//to be included in a fragment shader, not used standalone

float findShadowFactor(void) {
	if (!hasShadows) { return 1.0; }
	float shadow = 1.0;

	vec3 shadowNDC = IN.shadowProj.xyz / IN.shadowProj.w;
	if(	abs(shadowNDC.x) < 1.0 &&
		abs(shadowNDC.y) < 1.0 &&
		abs(shadowNDC.z) < 1.0) {

		vec3 biasCoord = shadowNDC * 0.5 + 0.5;
		float shadowZ  = texture(shadowTex, biasCoord.xy).x;
		if(shadowZ < biasCoord.z) {
			shadow = 0.0;
		}
	}
	return shadow;
}